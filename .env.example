# Broker MQTT local (mosquitto en la misma VM)
MQTT_BROKER=mqtt://localhost:1883
MQTT_USER=tu_usuario_mqtt
MQTT_PASS=tu_password_mqtt

# Firebase
FIREBASE_PROJECT_ID=iot-admin-panel
# Ruta al service account de Firebase Admin (NO se commitea, vive en la VM)
SERVICE_ACCOUNT_PATH=./serviceAccountKey.json
